# 🔀 ProxySQL Configuration - Enterprise++ Standard
# Load Balancer für MariaDB Cluster

datadir="/var/lib/proxysql"

admin_variables=
{
    admin_credentials="admin:admin"
    mysql_ifaces="0.0.0.0:6032"
    refresh_interval=2000
}

mysql_variables=
{
    threads=4
    max_connections=2048
    default_query_delay=0
    default_query_timeout=36000000
    have_compress=true
    poll_timeout=2000
    interfaces="0.0.0.0:6033"
    default_schema="information_schema"
    stacksize=1048576
    server_version="8.0.33"
    connect_timeout_server=10000
    monitor_history=60000
    monitor_connect_interval=60000
    monitor_ping_interval=10000
    ping_timeout_server=200
    commands_stats=true
    sessions_sort=true
}

proxysql_servers=
{
}

mysql_servers=
(
    {
        address="mariadb-master"
        port=3306
        hostgroup=0
        status="ONLINE"
        weight=1000
        compression=0
        max_connections=100
        max_replication_lag=0
        use_ssl=0
        max_latency_ms=0
        comment="MariaDB Master (Write)"
    },
    {
        address="mariadb-slave-1"
        port=3306
        hostgroup=1
        status="ONLINE"
        weight=100
        compression=0
        max_connections=100
        max_replication_lag=10
        use_ssl=0
        max_latency_ms=0
        comment="MariaDB Slave 1 (Read)"
    },
    {
        address="mariadb-slave-2"
        port=3306
        hostgroup=1
        status="ONLINE"
        weight=100
        compression=0
        max_connections=100
        max_replication_lag=10
        use_ssl=0
        max_latency_ms=0
        comment="MariaDB Slave 2 (Read)"
    }
)

mysql_users=
(
    {
        username="root"
        password="${DB_ROOT_PASSWORD}"
        default_hostgroup=0
        default_schema="lopez_erp"
        active=1
        use_ssl=0
        transaction_persistent=1
        fast_forward=0
        backend=1
        frontend=1
    }
)

mysql_query_rules=
(
    {
        rule_id=1
        active=1
        match_pattern="^SELECT.*"
        destination_hostgroup=1
        apply=1
        comment="Read queries → Slaves"
    },
    {
        rule_id=2
        active=1
        match_pattern="^(INSERT|UPDATE|DELETE|CREATE|ALTER|DROP).*"
        destination_hostgroup=0
        apply=1
        comment="Write queries → Master"
    }
)

mysql_replication_hostgroups=
(
    {
        writer_hostgroup=0
        reader_hostgroup=1
        comment="Master-Slave Replication"
    }
)



