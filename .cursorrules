# 🛡️ Cursor-Regeln für Lopez IT Welt Enterprise++
# Automatische Anti-Regelbruch-System-Aktivierung

# =====================================================
# 🟦 ENTERPRISE++ DEKLARATION
# =====================================================
#
# Lopez IT Welt ist ab sofort ein reines Enterprise++-System.
#
# Auf Niveau von:
# - SAP (Systemarchitektur, Prozesse, Compliance)
# - IBM (Enterprise-Standards, Sicherheit, Skalierbarkeit)
# - Siemens (Qualität, Dokumentation, Nachvollziehbarkeit)
#
# ✅ Nur UI | ✅ Nur Admin-Tools | ✅ Nur Workflows | ✅ Nur Audit-Logs
# ❌ Keine CMD | ❌ Keine Scripts | ❌ Keine Terminal (für Endbenutzer)
#
# Vollständige Deklaration: docs/ENTERPRISE-PLUS-PLUS-DEKLARATION.md
#
# =====================================================
# ENTERPRISE++ CURSOR-INTEGRATION
# =====================================================

# 🚀 AUTOMATISCHE AKTIVIERUNG
# Bei jedem Cursor-Start automatisch laden:
# import { initializeCursorIntegration } from './src/lib/cursor-integration';

# 🛡️ ANTI-REGELBRUCH-SYSTEM
# Automatische Aktivierung bei Cursor-Start
strictMode: true
zeroTolerance: true
autoBlock: true
requireApproval: true
validateBeforeAction: true
validateAfterAction: true
blockOnViolation: true

# 🤖 AGENTEN-AKTIVIERUNG
# Alle Agenten automatisch starten
autoActivateAgents: true
agentMonitoring: true
agentValidation: true

# 📋 ENTERPRISE-REGELN
# Alle Enterprise++ Regeln automatisch laden
autoLoadEnterpriseRules: true
ruleValidation: true
ruleEnforcement: true

# 🔍 VOR JEDER AKTION PRÜFEN
# Automatische Validierung vor jeder Cursor-Aktion
preActionValidation: true
postActionValidation: true
violationBlocking: true

# 📊 STATUS-ÜBERWACHUNG
# Automatische Status-Anzeige
statusMonitoring: true
statusReporting: true
statusLogging: true

# =====================================================
# ENTERPRISE++ STANDARDS
# =====================================================

# 🏢 ENTERPRISE-ARCHITEKTUR
enterpriseMode: true
scalableArchitecture: true
maintainableCode: true
professionalStandards: true

# 🔒 SICHERHEIT
securityFirst: true
privacyProtection: true
dataProtection: true
accessControl: true

# 📋 COMPLIANCE
dsgvoCompliance: true
licenseCompliance: true
auditTrail: true
documentationRequired: true

# 🎯 QUALITÄT
qualityStandards: true
codeReview: true
testingRequired: true
performanceOptimization: true

# =====================================================
# ANTI-REGELBRUCH-KONFIGURATION
# =====================================================

# 🚨 BLOCKIERUNG BEI VERSTÖSSEN
blockOnRuleViolation: true
blockOnSecurityViolation: true
blockOnComplianceViolation: true
blockOnQualityViolation: true

# ⏱️ ZEITERFASSUNG
requireSystemTime: true
blockDateCopying: true
validateTimestamps: true
enforceTimeTracking: true

# 📄 DOKUMENTATION
protectMdStructure: true
requireAppendOnly: true
preventOverwriting: true
documentationRequired: true

# 🔄 SESSION-MANAGEMENT
requireSessionSwitch: true
blockOverlappingSessions: true
sessionValidation: true
sessionTracking: true

# =====================================================
# AGENTEN-KONFIGURATION
# =====================================================

# 🤖 AGENTEN-AKTIVIERUNG
styleguardEnabled: true
securityAuditEnabled: true
deployBuddyEnabled: true
monitoringWaecherEnabled: true
complianceCheckerEnabled: true
aiTestAgentEnabled: true
snapshotArchivierungEnabled: true

# 🔍 AGENTEN-ÜBERWACHUNG
agentMonitoring: true
agentValidation: true
agentReporting: true
agentLogging: true

# 🚨 AGENTEN-BLOCKIERUNG
agentBlockOnViolation: true
agentBlockOnSecurityIssue: true
agentBlockOnComplianceIssue: true
agentBlockOnQualityIssue: true

# =====================================================
# CURSOR-INTEGRATION
# =====================================================

# 🚀 AUTOMATISCHE INITIALISIERUNG
autoInitialize: true
autoLoadRules: true
autoActivateAgents: true
autoStartMonitoring: true

# 🔍 AUTOMATISCHE VALIDIERUNG
autoValidateBeforeAction: true
autoValidateAfterAction: true
autoCheckCompliance: true
autoCheckSecurity: true

# 📊 AUTOMATISCHE ÜBERWACHUNG
autoMonitorStatus: true
autoReportViolations: true
autoLogActivities: true
autoTrackChanges: true

# =====================================================
# ENTERPRISE++ WORKFLOW
# =====================================================

# 📋 WORKFLOW-REGELN
requireApproval: true
requireDocumentation: true
requireTesting: true
requireReview: true

# 🔄 WORKFLOW-VALIDIERUNG
validateWorkflow: true
enforceWorkflow: true
trackWorkflow: true
reportWorkflow: true

# 🎯 WORKFLOW-ZIELE
enterpriseQuality: true
enterpriseSecurity: true
enterpriseCompliance: true
enterpriseScalability: true

# =====================================================
# AKTIVIERUNG
# =====================================================

# 🚀 SYSTEM AKTIVIEREN
# Diese Zeile aktiviert das komplette System
activateEnterpriseSystem: true

# 🛡️ ANTI-REGELBRUCH AKTIVIEREN
# Diese Zeile aktiviert das Anti-Regelbruch-System
activateAntiRuleBreakSystem: true

# 🤖 AGENTEN AKTIVIEREN
# Diese Zeile aktiviert alle Agenten
activateAllAgents: true

# 📋 REGELN AKTIVIEREN
# Diese Zeile aktiviert alle Enterprise-Regeln
activateEnterpriseRules: true

# =====================================================
# ÜBERWACHUNGS-REGELN
# =====================================================

# 🚨 VOR JEDER AKTION PRÜFEN
# Diese Regeln werden vor jeder Aktion ausgeführt
beforeAction:
  - validateSystemTime
  - checkApproval
  - validateMdStructure
  - checkDateCopying
  - validateTimeTracking

# 🛡️ BLOCKIERUNGS-REGELN
# Diese Aktionen werden automatisch blockiert
blockedActions:
  - "Datumskopieren ohne Freigabe"
  - "Md-Struktur-Änderungen ohne Freigabe"
  - "System-Zeit-Verwendung ohne Freigabe"
  - "Zeiterfassung ohne Wechsel"
  - "Überschreiben von Dokumentation"

# 📊 ÜBERWACHUNGS-AUSGABEN
# Diese Meldungen werden bei Aktivierung angezeigt
monitoringMessages:
  - "🛡️ Anti-Regelbruch-System: AKTIV"
  - "🤖 Agenten: AKTIV"
  - "📋 Enterprise-Regeln: GELADEN"
  - "🚨 Überwachung: AKTIV"
  - "⏰ System-Zeit: VALIDIERT"
  - "📄 Md-Struktur: GESCHÜTZT"
  - "🔒 Freigabe: ERFORDERLICH"

# 🔍 VALIDIERUNGS-REGELN
# Diese Validierungen werden ausgeführt
validations:
  systemTime: true
  approval: true
  mdStructure: true
  dateCopying: true
  timeTracking: true
  sessionSwitch: true
  compliance: true
  security: true
  quality: true

# =====================================================
# DSGVO-REGELN
# =====================================================

# 🛡️ DSGVO DECISION ENGINE (KI-FIREWALL)
# Zentrale KI-Firewall für rechtssichere KI-Verarbeitung
# - KI darf nur arbeiten, wenn alle DSGVO-Bedingungen erfüllt sind
# - Automatische Blockierung bei Verletzungen
# - Vollständige Audit-Logs
# - Rechtssichere Autonomie

# DSGVO Decision Engine Regeln:
# - Jede KI-Aktion MUSS zuerst dsgvoDecisionEngine.getAIProcessingPermission() prüfen
# - Wenn decision.allowed === false → KI-Verarbeitung blockieren
# - Alle Blockierungen müssen in dsgvo_audit_events geloggt werden
# - Consent-Prüfung: checkConsentForAI(userId, purpose)
# - DSGVO-Blocker-Prüfung: checkDSGVOBlockers(mediaId)
# - Risiko-Bewertung: evaluateRisk(mediaMeta, context)
# - Enforcement Layer: dsgvoEnforceMiddleware für API-Routen

# DSGVO Audit-Events:
# - AI_BLOCKED_NO_CONSENT
# - AI_BLOCKED_DSGVO_RISK_TOO_HIGH
# - AI_BLOCKED_PERSON_DETECTED
# - AI_BLOCKED_CONSENT_REVOKED
# - AI_BLOCKED_VERSION_MISMATCH
# - AI_ALLOWED
# - AI_PROCESSED

# Integration:
# - MediaAIService: DSGVO-Prüfung vor jeder KI-Analyse
# - API-Routen: dsgvoEnforceMiddleware vorgeschaltet
# - UI-Monitoring: /admin/compliance/dsgvo/ai-monitoring

# =====================================================
# KI-ORCHESTRATOR REGELN
# =====================================================

# 🛡️ KI-ORCHESTRATOR (Sprint 1)
# Zentrale Orchestrierung aller KI-Agenten
# - Orchestrator ist Single Source of Truth für KI-Flows
# - Niemals DSGVO Decision Engine umgehen
# - Nur registrierte Agenten verwenden
# - Vollständige Audit-Logs für alle Orchestrator-Events

# Orchestrator Regeln:
# - Jede KI-Aktion MUSS über OrchestratorCore.dispatchTask() laufen
# - AgentRegistry prüfen: Nur registrierte Agenten verwenden
# - ContextManager: Nur DSGVO/Scope-konforme Daten weitergeben
# - QualityGate: Input- und Output-Qualität prüfen
# - OrchestratorAudit: Alle ORCH_* Events loggen

# Agent-Registrierung:
# - Agenten müssen in AgentRegistry registriert sein
# - Agent-Definition: name, type, capabilities, dsgvoScope, riskProfile
# - Initialisierung: initializeOrchestrator() beim System-Start

# API-Endpoints:
# - /api/orchestrator/task (POST) - Task-Dispatch mit DSGVO-Prüfung
# - /api/orchestrator/agents (GET) - Agenten-Liste (read-only)
# - RBAC: orchestrator.manage / orchestrator.view

# UI:
# - /admin/orchestrator/ - Übersicht (Agenten, Events, Statistik)
# - /admin/orchestrator/agents - Agenten-Detail (DSGVO-Scope, Risk-Level, Toggle)
# - /admin/orchestrator/events - Events-Liste (Filter: Zeitraum, Agent, Status)

# =====================================================

# 🛡️ DSGVO-COMPLIANCE
# Automatische DSGVO-Compliance-Prüfung
dsgvoCompliance: true
dsgvoPersonDetection: true
dsgvoConsentRequired: true
dsgvoAuditLogging: true
dsgvoDeletionFristen: true

# 🔒 DSGVO-SICHERHEIT
# DSGVO-konforme Sicherheitsmaßnahmen
dsgvoEncryption: true
dsgvoAccessControl: true
dsgvoDataMinimization: true
dsgvoPseudonymization: true

# 📋 DSGVO-PROZESSE
# DSGVO-konforme Prozesse
dsgvoConsentManagement: true
dsgvoDataDeletion: true
dsgvoDataPortability: true
dsgvoRightToAccess: true

# 🤖 DSGVO-KI-INTEGRATION
# DSGVO-konforme KI-Integration
dsgvoMediaKI: true
dsgvoOrchestratorKI: true
dsgvoQualityGates: true
dsgvoAuditTrail: true 