# =====================================================
# LOPEZ IT WELT - ENVIRONMENT VARIABLES (EXAMPLE)
# =====================================================
# WICHTIG: Diese Datei enthÃ¤lt nur Platzhalter!
# 
# Anleitung:
# 1. Kopiere diese Datei zu .env
# 2. FÃ¼lle die Werte mit echten Secrets aus
# 3. .env wird NICHT ins Repository committet
# 4. Speichere echte Keys in Passwortmanager
# =====================================================

# =====================================================
# DATABASE CONFIGURATION
# =====================================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-database-password-here
DB_NAME=lopez_it_welt

# =====================================================
# OPENAI CONFIGURATION
# =====================================================
# WICHTIG: OpenAI API Key beschaffen unter:
# https://platform.openai.com/api-keys
# 
# Key-Format: sk-... (beginnt mit "sk-")
# 
# Speichere den echten Key:
# - In .env (lokal, nicht im Repository)
# - In Passwortmanager (1Password, Bitwarden, etc.)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Provider-Auswahl: mock | openai | google | azure | local
# Default: mock (fÃ¼r Entwicklung ohne echte API-Keys)
MEDIA_AI_PROVIDER=mock

# OpenAI Modell (wenn MEDIA_AI_PROVIDER=openai)
OPENAI_MODEL=gpt-4-vision-preview

# =====================================================
# MEDIA AI COST LIMITS
# =====================================================
# TÃ¤gliches Limit in USD (z.B. 10.00 = $10 pro Tag)
MEDIA_AI_DAILY_LIMIT_USD=10.00

# Monatliches Limit in USD (z.B. 200.00 = $200 pro Monat)
MEDIA_AI_MONTHLY_LIMIT_USD=200.00

# Warnung bei X% des Limits (0.8 = 80%)
MEDIA_AI_WARNING_THRESHOLD=0.8

# =====================================================
# MEDIA AI ASYNC PROCESSING
# =====================================================
# Maximale Anzahl Medien pro Batch
MEDIA_AI_ASYNC_BATCH_SIZE=10

# Maximale Anzahl Retry-Versuche
MEDIA_AI_MAX_RETRIES=3

# VerzÃ¶gerung zwischen Retries in Millisekunden
MEDIA_AI_RETRY_DELAY_MS=5000

# =====================================================
# CRON JOB SECURITY
# =====================================================
# Secret fÃ¼r Cron-Job-Authentifizierung
# WICHTIG: In Production MUSS dieser Wert gesetzt sein!
CRON_SECRET=your-secure-cron-secret-here

# =====================================================
# JWT & AUTHENTICATION
# =====================================================
# JWT Secret fÃ¼r Token-Generierung
# WICHTIG: In Production Ã¤ndern!
JWT_SECRET=your-super-secret-jwt-key-here

# =====================================================
# EMAIL CONFIGURATION
# =====================================================
# SMTP-Konfiguration (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-here
SMTP_FROM=noreply@lopez-it-welt.de

# =====================================================
# APPLICATION CONFIGURATION
# =====================================================
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# =====================================================
# DEVELOPMENT MODE (nur fÃ¼r Entwicklung)
# =====================================================
# Development Mode aktivieren (nur in Development)
DEVELOPMENT_MODE=false
BYPASS_AUTH=false
